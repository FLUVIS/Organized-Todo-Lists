<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="600.0" styleClass="base" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <BorderPane prefHeight="59.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <left>
            <VBox prefHeight="71.0" prefWidth="489.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="titleBox" text="Label">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <HBox prefHeight="26.0" prefWidth="199.0">
                     <children>
                        <TextField fx:id="taskField" prefHeight="25.0" prefWidth="351.0">
                           <font>
                              <Font size="16.0" />
                           </font></TextField>
                        <Button fx:id="addTaskButton" maxHeight="35.0" minHeight="35.0" mnemonicParsing="false" onAction="#addTask" prefHeight="35.0">
                           <font>
                              <Font size="14.0" />
                           </font></Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </left>
         <center>
            <AnchorPane prefHeight="71.0" prefWidth="213.0" BorderPane.alignment="CENTER" />
         </center>
         <right>
            <VBox alignment="TOP_RIGHT" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="backButton" mnemonicParsing="false" onAction="#back" text="Back">
                     <font>
                        <Font size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets right="5.0" top="10.0" />
                     </VBox.margin></Button>
               </children>
            </VBox>
         </right>
      </BorderPane>
   </top>
   <center>
      <ScrollPane fx:id="scrollPane" prefWidth="600.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="taskBox" prefHeight="595.0" prefWidth="585.0" styleClass="taskLines" />
         </content></ScrollPane>
   </center>
   <bottom>
      <Button fx:id="clearButton" mnemonicParsing="false" onAction="#clearMarkedTasks" text="Clear Finished Tasks" BorderPane.alignment="CENTER">
         <font>
            <Font size="16.0" />
         </font></Button>
   </bottom>
</BorderPane>
